{
  "name": "duartec-inventario-pwa",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:sync:android": "npm run build:web && npx cap sync android",
    "cap:sync:ios": "npm run build:web && npx cap sync ios",
    "publish:android": "bundle exec fastlane android deploy",
    "publish:android:build": "bundle exec fastlane android build_release",
    "publish:ios": "bundle exec fastlane ios deploy",
    "publish:ios:build": "bundle exec fastlane ios build_release",
    "test": "node --test tests/*.test.js",
    "check": "node --check js/app.js && node --check js/scanner.js && node --check js/storage.js && node --check js/ui.js && node --check js/utils.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/status-bar": "^8.0.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "html5-qrcode": "^2.3.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@resvg/resvg-js": "^2.6.2"
  }
}
