require "json"

default_platform(:android)

def app_store_connect_api_key_from_env
  json = ENV["APP_STORE_CONNECT_API_KEY_JSON"]
  return nil if json.to_s.strip.empty?

  key_data = JSON.parse(json)
  app_store_connect_api_key(
    key_id: key_data.fetch("key_id"),
    issuer_id: key_data.fetch("issuer_id"),
    key_content: key_data.fetch("key_content"),
    is_key_content_base64: key_data.fetch("is_key_content_base64", false),
  )
end

platform :android do
  desc "Build release AAB for Play Store"
  lane :build_release do
    sh("npm run build:web")
    sh("npx cap sync android")
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android"
    )
  end

  desc "Build and upload to Google Play"
  lane :deploy do
    build_release
    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "internal"),
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_JSON_KEY_DATA"],
      json_key: ENV["PLAY_JSON_KEY_PATH"],
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "draft")
    )
  end
end

platform :ios do
  desc "Build IPA for App Store Connect"
  lane :build_release do
    setup_ci if ENV["CI"]
    sh("npm run build:web")
    sh("npx cap sync ios")
    build_ios_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: ENV.fetch("IOS_EXPORT_METHOD", "app-store"),
      output_directory: "build/ios",
      output_name: "DuartecInventario.ipa"
    )
  end

  desc "Build and upload to App Store Connect"
  lane :deploy do
    build_release
    api_key = app_store_connect_api_key_from_env
    upload_to_app_store(
      ipa: "build/ios/DuartecInventario.ipa",
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      force: true,
      api_key: api_key,
      apple_id: ENV["APPLE_ID"],
      itc_provider: ENV["ITC_PROVIDER"]
    )
  end
end
